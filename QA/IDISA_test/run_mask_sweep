#!/bin/bash
#
# Usage: ./run_mask_sweep <path-to-idisa_test>
#
# Runs mvmd_compress and mvmd_expand at every field width over inputs that
# enumerate all 65536 16-bit block patterns. The distinct mask spaces this
# covers are 65536, 256, 16 and 4 at fw 8, 16, 32 and 64: every possible
# mask at every width, not 65536 at every width. Data files are generated
# on first use.

idisa_test="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
cd "$(dirname "$0")"

if [ ! -f mask_sweep_a ] || [ ! -f mask_sweep_b ]; then
    python3 gen_mask_sweep.py || exit 1
fi

failures=0
crashes=0
for op in mvmd_compress mvmd_expand; do
    for fw in 8 16 32 64; do
        "$idisa_test" -q $op $fw mask_sweep_a mask_sweep_b
        status=$?
        # Report signal failures separately from incorrect output.
        if [ $status -eq 0 ]; then
            echo "PASS: $op fw=$fw"
        elif [ $status -ge 128 ]; then
            echo "CRASH: $op fw=$fw (signal $((status - 128)), not a wrong result)"
            crashes=$((crashes + 1))
        else
            echo "FAIL: $op fw=$fw (wrong result)"
            failures=$((failures + 1))
        fi
    done
done

if [ $crashes -gt 0 ]; then
    echo "$crashes crashed, $failures gave wrong results"
fi
exit $((failures + crashes))
